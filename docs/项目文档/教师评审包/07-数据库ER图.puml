@startuml
hide circle
skinparam linetype ortho
skinparam packageStyle rectangle

package "core" {
  entity "app_user" as user {
    * id : text
    --
    username : text
    display_name : text
    identity_no : text
    role : text
    active : boolean
  }
  entity "session" as session {
    * token : text
    --
    user_id : text
    expires_at : timestamptz
  }
}

package "projects" {
  entity "project" as project {
    * id : text
    --
    name : text
    owner_user_id : text
    advisor_user_id : text
    document_url : text
    repository_url : text
    status : text
    starts_at : timestamptz
    ends_at : timestamptz
  }
  entity "project_member" as member {
    * project_id : text
    * user_id : text
    --
    member_role : text
    joined_at : timestamptz
  }
  entity "task" as task {
    * id : text
    --
    project_id : text
    assignee_id : text
    creator_user_id : text
    reviewer_user_id : text
    title : text
    status : text
    due_date : date
  }
  entity "progress_report" as report {
    * id : text
    --
    project_id : text
    author_id : text
    help_needed : text
    status : text
  }
  entity "project_note" as note {
    * id : text
    --
    project_id : text
    author_id : text
    title : text
  }
}

package "inventory" {
  entity "material_category" as category {
    * id : text
    --
    code : text
    name : text
    return_required : boolean
    quantity_mode : text
    serial_required : boolean
  }
  entity "material" as material {
    * id : text
    --
    category_id : text
    name : text
    stock : int
    location : text
    dynamic_attributes : jsonb
  }
  entity "application" as application {
    * id : text
    --
    material_id : text
    applicant_id : text
    project_id : text
    usage_mode : text
    due_at : timestamptz
    returned_at : timestamptz
    status : text
  }
  entity "stock_movement" as movement {
    * id : text
    --
    material_id : text
    operator_id : text
    type : text
    quantity : int
  }
}

package "files" {
  entity "lab_file" as file {
    * id : text
    --
    project_id : text
    report_id : text
    parent_id : text
    storage_provider : text
  }
  entity "file_version" as version {
    * id : text
    --
    file_id : text
    uploader_id : text
    version : int
  }
}

package "collaboration" {
  entity "meeting" as meeting {
    * id : text
    --
    project_id : text
    created_by : text
    title : text
    status : text
  }
  entity "notification" as notification {
    * id : text
    --
    project_id : text
    recipient_id : text
    type : text
  }
}

package "ai" {
  entity "knowledge_document" as knowledge {
    * id : text
    --
    created_by : text
    title : text
    project_id : text
  }
  entity "chat_history" as chat {
    * id : text
    --
    user_id : text
    role : text
    created_at : timestamptz
  }
}

user ||--o{ session
user ||--o{ member
project ||--o{ member
project ||--o{ task
project ||--o{ report
project ||--o{ note
project ||--o{ application
project ||--o{ file
project ||--o{ meeting
project ||--o{ notification
category ||--o{ material
material ||--o{ application
material ||--o{ movement
file ||--o{ version
user ||--o{ chat
user ||--o{ knowledge

@enduml
